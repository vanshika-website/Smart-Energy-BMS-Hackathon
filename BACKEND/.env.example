PORT=5000

# Firebase Realtime Database (Admin SDK)
FIREBASE_DB_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com
# One of the following credential options:
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Per-device power limits (watts). Devices here are auto-registered under phase3 unless overridden in JSON.
POWER_LIMIT_AC=3000
POWER_LIMIT_HEATER=2500
POWER_LIMIT_MICROWAVE=2200
POWER_LIMIT_TV=350
POWER_LIMIT_LIGHTS=300
POWER_LIMIT_CHARGER=120

# Optional full registry (overrides phase/segment per device). Use firebaseSegment when path differs from id (e.g. phase2 relay).
# DEVICE_REGISTRY_JSON=[{"id":"ac","phase":"phase3","powerLimitW":3000},{"id":"lights","phase":"phase2","firebaseSegment":"relay","powerLimitW":300}]

# HiveMQ Cloud — TLS MQTT port 8883 (Node mqtt.js)
# Example: mqtts://YOUR_CLUSTER.s1.eu.hivemq.cloud:8883
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
# Must match dashboard publish topic(s) you want the server to consume
MQTT_CONTROL_TOPIC=home/control/device
